        "required": [
          "seq",
          "timestamp",
          "run_id",
          "fixture_id",
          "module",
          "resource_reference",
          "decision",
          "confidence",
          "lane",
          "lane_reason",
          "latency_ms",
          "jev_latency_ms",
          "tokens_used",
          "ground_truth_match"
