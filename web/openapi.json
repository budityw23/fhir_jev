            "title": "Ground Truth Match"
          },
          "jev_latency_ms": {
            "title": "Jev Latency Ms",
            "type": "number"
          },
          "lane": {
            "enum": [
              "auto_accepted",
              "routed",
              "flagged",
              "review"
            ],
            "title": "Lane",
            "type": "string"
          },
          "lane_reason": {
            "title": "Lane Reason",
            "type": "string"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "module": {
            "enum": [
              "quality",
              "router",
              "notifiable"
            ],
            "title": "Module",
            "type": "string"
          },
          "resource_reference": {
            "title": "Resource Reference",
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "timestamp": {
            "format": "date-time",
