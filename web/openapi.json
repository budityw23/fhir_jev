        "type": "object"
      },
      "CompareRequest": {
        "description": "A FHIR resource to decide, with an optional fixture id (for ground truth) and overrides.",
        "properties": {
          "fixture_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixture Id"
          },
          "resource": {
            "additionalProperties": true,
            "title": "Resource",
            "type": "object"
          },
          "resource_type": {
            "anyOf": [
              {
                "enum": [
                  "Patient",
                  "Observation"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Type"
          },
          "thresholds": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ThresholdOverrides"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "resource"
        ],
        "title": "CompareRequest",
        "type": "object"
      },
      "CompareResponse": {
        "description": "A Jev decision side by side with the rules, ground truth, lane and audit trail.",
        "properties": {
          "audit_event": {
            "additionalProperties": true,
            "title": "Audit Event",
            "type": "object"
          },
          "ground_truth": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ground Truth"
          },
          "jev": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QualityScoreResponse"
              },
              {
                "$ref": "#/components/schemas/BundleRouteResponse"
              },
              {
                "$ref": "#/components/schemas/NotifiableDetectionResponse"
              }
            ],
            "title": "Jev"
          },
          "jev_decision": {
            "title": "Jev Decision",
            "type": "string"
          },
          "jev_raw": {
            "items": {
              "$ref": "#/components/schemas/JevCall"
