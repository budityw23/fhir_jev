            "title": "Jev Raw",
            "type": "array"
          },
          "lane": {
            "enum": [
              "auto_accepted",
              "routed",
              "flagged",
              "review"
            ],
            "title": "Lane",
            "type": "string"
          },
          "lane_reason": {
            "title": "Lane Reason",
            "type": "string"
          },
          "module": {
            "enum": [
              "quality",
              "router",
              "notifiable"
            ],
            "title": "Module",
            "type": "string"
          },
          "override_applied": {
            "title": "Override Applied",
            "type": "boolean"
          },
          "rule": {
            "$ref": "#/components/schemas/RuleDecision"
          },
          "serialized_state": {
            "additionalProperties": true,
            "title": "Serialized State",
            "type": "object"
          },
          "thresholds": {
            "$ref": "#/components/schemas/Thresholds"
          },
          "tokens_used": {
            "title": "Tokens Used",
            "type": "integer"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          }
        },
        "required": [
          "module",
          "jev",
          "jev_decision",
          "jev_raw",
          "rule",
          "ground_truth",
          "verdict",
          "serialized_state",
          "override_applied",
          "lane",
          "lane_reason",
          "audit_event",
          "thresholds",
          "tokens_used"
        ],
        "title": "CompareResponse",
        "type": "object"
      },
