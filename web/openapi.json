          "answer": {
            "title": "Answer",
            "type": "boolean"
          },
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          },
          "probability": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability",
            "type": "number"
          },
          "tokens_used": {
            "minimum": 0.0,
            "title": "Tokens Used",
            "type": "integer"
          }
        },
        "required": [
          "answer",
          "probability",
          "latency_ms",
          "tokens_used"
        ],
        "title": "NoulResult",
        "type": "object"
      },
      "PipelineRunRequest": {
        "description": "What to replay: fixture source, modules, pacing, and optional threshold overrides.",
        "properties": {
          "modules": {
            "default": [
              "quality",
              "router",
              "notifiable"
            ],
            "items": {
              "enum": [
                "quality",
                "router",
                "notifiable"
              ],
              "type": "string"
            },
            "title": "Modules",
            "type": "array"
          },
          "rate_per_s": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 50.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": 4.0,
            "title": "Rate Per S"
          },
          "source": {
            "default": "unit",
            "enum": [
              "all",
              "unit",
              "hard",
              "generated",
              "demo"
            ],
            "title": "Source",
            "type": "string"
          },
          "thresholds": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ThresholdOverrides"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "PipelineRunRequest",
        "type": "object"
      },
      "PipelineRunResponse": {
        "description": "Acknowledgement of a started run; decisions arrive through the feed.",
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "const": "started",
            "title": "Status",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "total",
          "status"
        ],
        "title": "PipelineRunResponse",
        "type": "object"
      },
