# Secrets — real keys live only in .env (see .env.example)
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test / lint / type caches
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Demo UI (web/)
web/node_modules/
web/dist/
web/e2e/screenshots/
web/test-results/
web/playwright-report/
web/*.tsbuildinfo

# Local tooling
.claude/settings.local.json
.kilo/
.DS_Store

# Job-application material stays out of this public repo
*upwork*

# Large regenerable media; the narrated MP4 is the tracked copy
docs/demo-video/*.wav
docs/demo-video/*.mp3
docs/demo-video/jev-fhir-demo-narrated.webm

# Phase loop (.phase/): logs and exit codes are local; prompts, results and sessions are tracked
.phase/*.log
.phase/*.exit
